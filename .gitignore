node_modules/
jslib/dist/
jslib/typings/
jslib/coverage/
jslib/.rollup.cache/
*.tgz

# ⚠ `pylightcharts/js/*` 是**随 wheel 发布**的前端资源，必须提交！
#   下面两行是"改成发布时才构建"的开关，默认**保持注释**（否则 CI 的 js
#   一致性任务拿不到产物，`pip install` 也不带前端 ✗）
# pylightcharts/js/bundle.js
# pylightcharts/js/lightweight-charts.js

# ★ desk 打开时会往这个目录**写** qwebchannel.js（运行期生成，随宿主 Qt 版本
#   变化），不随仓库上传 ✓
pylightcharts/js/qwebchannel.js

